{
  "name": "jobfill",
  "version": "1.0.0",
  "private": true,
  "description": "Privacy-first Chrome extension that auto-fills job applications from a locally stored profile.",
  "type": "module",
  "license": "MIT",
  "author": "Phillip Huang",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "package": "node scripts/build.mjs && node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "demo": "node scripts/serve-demo.mjs",
    "test:e2e": "node tests/e2e/extension.e2e.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/chrome": "^0.3.6",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^3.2.7",
    "adm-zip": "^0.6.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "puppeteer-core": "^24.43.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "pdfjs-dist": "^4.10.38"
  }
}
