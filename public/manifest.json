{
  "manifest_version": 3,
  "name": "JobFill — Job Application Autofill",
  "short_name": "JobFill",
  "version": "0.0.0",
  "description": "Auto-fill job applications on Greenhouse, Lever, Workday, Ashby and more from a profile stored only on your device.",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "JobFill",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "unlimitedStorage", "scripting", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "autofill": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Auto-fill the job application in the current tab"
    }
  }
}
